# PulseBeacon Environment Variables Example

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FastAPI Backend & Database
DATABASE_URL="sqlite:///./attendance.db"
# For production PostgreSQL:
# POSTGRES_DATABASE_URL="postgresql://user:password@localhost:5432/pulsebeacon_db"

# Security & Secrets
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
BLE_HMAC_SECRET="replace_with_a_secure_hmac_secret_for_ble_broadcasting"
BLE_NONCE_VALIDITY_WINDOW_SECONDS=30
BLE_MAX_ACCEPTABLE_DISTANCE_METERS=8.0
BLE_RSSI_PATH_LOSS_EXPONENT=2.4
BLE_REFERENCE_RSSI_1M=-59.0

# Frontend API Target
VITE_API_BASE_URL="http://localhost:8000/api"
